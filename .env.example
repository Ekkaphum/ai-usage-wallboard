# Copy to .env.local. Everything here is optional except INGEST_TOKEN, and that
# one only matters when the board and the accounts live on different machines.

# Shared secret between a collector and the wallboard it pushes to. Must be
# identical on both machines. Unset means /api/ingest refuses every request,
# which is the right default for a single-machine setup.
#   openssl rand -hex 24
INGEST_TOKEN=

# Set to 1 on a display-only machine. Refuses writes to config/accounts.json
# from the settings page, so a board reachable over the LAN cannot be
# reconfigured from a browser.
WALLBOARD_READONLY=0

# Where the collector pushes to. Only read by scripts/collect.ts.
# WALLBOARD_URL=http://192.168.1.50:4000

# Override the SQLite location. Defaults to ./data/usage.db
# DATABASE_PATH=data/usage.db
