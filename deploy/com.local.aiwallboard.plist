<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.aiwallboard</string>

  <!-- __PROJECT_DIR__ and __NODE__ are filled in by deploy/install.sh -->
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__PROJECT_DIR__/node_modules/.bin/next</string>
    <string>start</string>
    <string>--hostname</string>
    <!-- Bound to loopback on purpose: the board reads local logs and can write
         config, so it must not be reachable from the network by default. -->
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>4000</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/wallboard.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/wallboard.err.log</string>
</dict>
</plist>
